# Usado automaticamente por "npm run build" / "npm run deploy" (NÃO afeta o "npm run dev").
# true  = site publicado funciona sozinho, com dados de exemplo no navegador.
# false = usa o back-end real (defina também VITE_API_URL com a URL HTTPS da sua API).
VITE_MODO_DEMO=true
